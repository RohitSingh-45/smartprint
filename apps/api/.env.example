# SmartPrint API
# Copy to .env and adjust values for local development.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/smartprint
CORS_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=100kb
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=26214400
STORAGE_DRIVER=local
DRAFT_DIR=drafts
DRAFT_TTL_SECONDS=900
ORDER_DIR=orders
PRINTER_DIR=printers
# Shared secret for Local Print Agent (keep out of the browser / NEXT_PUBLIC_*)
PRINT_AGENT_TOKEN=smartprint-dev-agent-token

# mock | razorpay  (use mock for local UI testing without Razorpay keys)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
