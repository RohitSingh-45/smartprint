# SmartPrint Local Print Agent
SMARTPRINT_API_URL=http://localhost:4000
PRINT_AGENT_TOKEN=smartprint-dev-agent-token
AGENT_NAME=Campus Hub Agent
# mock | system
PRINT_MODE=mock
# Optional: force a simulated printer fault on the next job
# SIMULATE_FAULT=PAPER_JAM|OUT_OF_PAPER|LOW_TONER|ERROR|OFFLINE|FAIL
POLL_INTERVAL_MS=3000
HEARTBEAT_INTERVAL_MS=10000
JOB_DIR=agent-jobs
