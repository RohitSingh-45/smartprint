{
  "name": "smartprint",
  "version": "0.1.0",
  "private": true,
  "description": "SmartPrint — QR-based smart printing platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @smartprint/web",
    "dev:api": "npm run dev -w @smartprint/api",
    "dev:agent": "npm run dev -w @smartprint/print-agent",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @smartprint/web",
    "build:api": "npm run build -w @smartprint/api",
    "build:agent": "npm run build -w @smartprint/print-agent",
    "start:web": "npm run start -w @smartprint/web",
    "start:api": "npm run start -w @smartprint/api",
    "start:agent": "npm run start -w @smartprint/print-agent",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
